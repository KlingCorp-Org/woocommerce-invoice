#. Plugin Name of the plugin
#: order-documents.php
msgid "Order Documents for WooCommerce"
msgstr "Ordredokumenter for WooCommerce"

#. Description of the plugin
#: order-documents.php
msgid "PDF invoices, packing slips, delivery notes, credit notes, proforma invoices, receipts and picking lists for WooCommerce, with design templates and a visual layout editor."
msgstr "PDF-fakturaer, pakksedler, følgesedler, kreditnotaer, proformafakturaer, kvitteringer og plukklister for WooCommerce, med designmaler og visuell layoutredigering."

#: order-documents.php:67
