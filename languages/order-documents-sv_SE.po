#. Plugin Name of the plugin
#: order-documents.php
msgid "Order Documents for WooCommerce"
msgstr "Orderdokument för WooCommerce"

#. Description of the plugin
#: order-documents.php
msgid "PDF invoices, packing slips, delivery notes, credit notes, proforma invoices, receipts and picking lists for WooCommerce, with design templates and a visual layout editor."
msgstr "PDF-fakturor, packsedlar, följesedlar, kreditfakturor, proformafakturor, kvitton och plocklistor för WooCommerce, med designmallar och visuell layoutredigerare."

