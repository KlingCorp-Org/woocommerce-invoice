#. Plugin Name of the plugin
#: order-documents.php
msgid "Order Documents for WooCommerce"
msgstr "Ordredokumenter til WooCommerce"

#. Description of the plugin
#: order-documents.php
msgid ""
"PDF invoices, packing slips, delivery notes, credit notes, proforma "
"invoices, receipts and picking lists for WooCommerce, with design templates "
"and a visual layout editor."
msgstr ""
"PDF-fakturaer, pakkesedler, følgesedler, kreditnotaer, proformafakturaer, "
"kvitteringer og pluklister til WooCommerce, med designskabeloner og visuel "
"layouteditor."

#: order-documents.php:67
msgid ""
"Order Documents for WooCommerce requires WooCommerce to be installed and "
"active."
msgstr ""
"Ordredokumenter til WooCommerce kræver, at WooCommerce er installeret og "
"aktiveret."

